    SpectatorLabel.Text = tostring(count)
    local box = SpectatorGui and SpectatorGui:FindFirstChild("MainBox")
    if box then
        local width = 55 + (count >= 10 and 8 or 0) + (count >= 100 and 8 or 0)
        box.Size = UDim2.new(0, width, 0, 22)
    end
end
