                    ad.Adornee = part
                    ad.Size = part.Size
                    ad.Color3 = Color3.fromRGB(0, 200, 255)
                    ad.Transparency = 0.8
                end
            end
        end
    end
    if ESP_Hook then
        for _, v in ipairs(Hooks) do
            if v and v.Parent then
                local high = v:FindFirstChild("HookEH")
                if not high then
                    high = Instance.new("Highlight")
                    high.Name = "HookEH"
                    high.Parent = v
                end
                high.FillColor = Color3.fromRGB(255, 105, 180)
                high.OutlineColor = Color3.fromRGB(255, 105, 180)
                high.FillTransparency = 1
                high.OutlineTransparency = 0
            end
        end
    end
    if ESP_Gate then
        for _, v in ipairs(Gates) do
            if v and v.Parent then
                local high = v:FindFirstChild("GateEH")
                if not high then
                    high = Instance.new("Highlight")
                    high.Name = "GateEH"
                    high.Parent = v
                end
                high.Adornee = v
