local animTracked = {}

local function trackAnimations(character)
    if not character or animTracked[character] then return end
    animTracked[character] = true
    local hum = character:FindFirstChild("Humanoid")
    if not hum then
        hum = character:WaitForChild("Humanoid", 5)
        if not hum then return end
    end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = hum:WaitForChild("Animator", 5)
        if not animator then return end
    end
    hum.ChildAdded:Connect(function(child)
        if child:IsA("Animator") then
            animTracked[character] = nil
            trackAnimations(character)
        end
    end)
    character.AncestryChanged:Connect(function(_, parent)
        if not parent then
            animTracked[character] = nil
        end
    end)
    animator.AnimationPlayed:Connect(function(animation)
        local id = (animation.Animation and animation.Animation.AnimationId or ""):match("%d+")
        local name = SkillNames[id]
        if not name then return end
        if id == "80411309607666" and Surv_AutoCrouch then
            local myChar = LocalPlayer.Character
            if isKnockedOrHooked(myChar) then return end
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local otherRoot = character:FindFirstChild("HumanoidRootPart")
            if myRoot and otherRoot and (myRoot.Position - otherRoot.Position).Magnitude <= 40 then
                autoCrouch()
            end
            return
        end
        if not Surv_AutoParry then return end
        if ParryCooldown then return end
        if Ignored_Skills_List and Ignored_Skills_List[name] then return end
        local myChar = LocalPlayer.Character
        if isKnockedOrHooked(myChar) or not isParrySafe(myChar) then return end
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local otherRoot = character:FindFirstChild("HumanoidRootPart")
        if not myRoot or not otherRoot then return end
        local dist = (myRoot.Position - otherRoot.Position).Magnitude
        if Surv_ParryAggressive then
            if dist > Surv_ParryRadius + 5 then return end
            if dist <= 12 then
                performParry()
                return
            end
            local conn
            local start = os.clock()
            conn = RunService.Heartbeat:Connect(function()
                if os.clock() - start >= 1.5 or ParryCooldown or not myRoot or not otherRoot or isKnockedOrHooked(myChar) then
                    if conn then conn:Disconnect() end
                    return
                end
                if (myRoot.Position - otherRoot.Position).Magnitude <= 12 then
                    performParry()
                    if conn then conn:Disconnect() end
                end
            end)
            return
        end
        if dist > Surv_ParryRadius then return end
        local dir = Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z) - Vector3.new(otherRoot.Position.X, 0, otherRoot.Position.Z)
        if dir.Magnitude > 0 then
            local unit = dir.Unit
            if Vector3.new(otherRoot.CFrame.LookVector.X, 0, otherRoot.CFrame.LookVector.Z).Unit:Dot(unit) < Surv_ParryFace then
                return
            end
        end
        performParry()
    end)
end

