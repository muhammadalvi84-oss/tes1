                end
            end
            task.wait(5)
            if AUTO_AFKEscape and LocalPlayer.Team and LocalPlayer.Team.Name == "Survivors" then
                if Library then Library:Notify("Match (Stuck), mencari server baru...", 3) end
                serverHop()
            end
        end)
    elseif team == "Spectator" then
        AFK_Thread = task.spawn(function()
