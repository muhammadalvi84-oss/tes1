UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        if PistolLockActive then
            PistolLockActive = false
            lockedTarget = nil
        end
        if FlashSilentActive then
            FlashSilentActive = false
        end
    end
    if VeilSilentActive and (input == aimTouchInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
        VeilSilentActive = false
        if input == aimTouchInput then aimTouchInput = nil end
        if VeilCooldown then return end
        VeilCooldown = true
        task.delay(2, function() VeilCooldown = false end)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and (char:FindFirstChild("Head") or root)
        if head and root then
            local startPos = char:GetAttribute("special") == true and root.Position or head.Position
            local target = findVeilTarget()
            local dir
            if target then
                local targetPart = target:IsA("Model") and target:FindFirstChild("HumanoidRootPart") or target
                local targetPos = targetPart.Position
                local vel = Vector3.new(0, 0, 0)
                if targetPart:IsA("BasePart") then
                    vel = Vector3.new(targetPart.AssemblyLinearVelocity.X, 0, targetPart.AssemblyLinearVelocity.Z)
                end
                local dist = (targetPos - startPos).Magnitude
                local flightTime = dist / (SPEAR_Speed or 165)
                local predicted = targetPos + vel * flightTime
                local gravFactor = math.clamp(dist / 100, 1, 2.5)
                local extraGravity = (0.5 * (AIM_Auto and math.max(0, dist - 8) or (SPEAR_Gravity or 103))) * flightTime ^ 2 * gravFactor
                local finalPos = predicted + Vector3.new(0, extraGravity, 0)
                dir = (finalPos - startPos).Unit
            else
                dir = CurrentCamera.CFrame.LookVector
            end
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    local killers = remotes:FindFirstChild("Killers")
                    if killers then
                        local veil = killers:FindFirstChild("Veil")
                        if veil then
                            veil.Spearthrow:FireServer(dir, SPEAR_Speed or 165, startPos)
                        end
                    end
                end
            end)
        end
    end
    if input.UserInputType == Enum.UserInputType.Touch and input == aimTouchInput then
        if PistolLockActive then
            PistolLockActive = false
            aimTouchInput = nil
            firePistol()
            lockedTarget = nil
        end
        if FlashSilentActive then
            FlashSilentActive = false
            aimTouchInput = nil
        end
    end
end)

