                high.OutlineColor = Color3.fromRGB(0, 255, 255)
                high.FillTransparency = 1
                high.OutlineTransparency = 0
            end
        end
    end
end

local function updateScpEsp()
    if not ESP_Master then return end
    if ESP_SCP then
        for _, v in ipairs(SCPs) do
            if v and v.Parent then
                local hum = v:FindFirstChildOfClass("Humanoid")
                local root = v:FindFirstChild("HumanoidRootPart")
                if hum and (root or v:FindFirstChild("Torso") or v.PrimaryPart) and hum.Health > 0 and math.floor(hum.WalkSpeed) == 9 then
                    local high = v:FindFirstChild("SCPEH")
                    if not high then
                        high = Instance.new("Highlight")
                        high.Name = "SCPEH"
                        high.Parent = v
                    end
                    high.FillColor = Color3.fromRGB(255, 0, 255)
                    high.OutlineColor = Color3.fromRGB(255, 0, 255)
                    high.FillTransparency = 1
                    high.OutlineTransparency = 0
                else
                    local high = v:FindFirstChild("SCPEH")
                    if high then high:Destroy() end
                end
            end
        end
        return
    end
    clearEsp("SCP")
end

local function getNearestSurvivorForAutoKill()
    local char, dist = nil, 1e999
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
