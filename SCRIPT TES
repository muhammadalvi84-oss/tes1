local function findAimbotTarget()
    local team = getPlayerTeamName()
    local radius = Surv_Aimbot_Radius
    local nearestDist = 1e999
    local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)
    local target = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local valid = false
            if team == "Survivor" then
                valid = Surv_Aimbot_Enabled and isKiller(player)
            elseif team == "Killer" then
                if Killer_Aimbot_Enabled and not isKiller(player) then
                    local hum = player.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 and not isKnockedOrHooked(player.Character) then
                        valid = true
                    end
                end
            end
            if valid then
                local hrp = player.Character.HumanoidRootPart
                local pos = hrp.Position
                local dist = getDistanceFromPlayer(pos)
                if team == "Survivor" and dist <= Surv_Aimbot_MaxDist then
                    local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(pos)
                    if onScreen then
                        local mag = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if mag < radius then
                            radius = mag
                            target = hrp
                        end
                    end
                elseif team == "Killer" and dist <= Killer_Aimbot_MaxDist and dist < nearestDist then
                    nearestDist = dist
                    target = hrp
                end
            end
        end
    end
    return target
end

