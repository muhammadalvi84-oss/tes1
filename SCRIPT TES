local SkillCheckLine = SkillCheckCheck and SkillCheckCheck:FindFirstChild("Line") or SkillCheckCheck:WaitForChild("Line", 5)
local SkillCheckGoal = SkillCheckCheck and SkillCheckCheck:FindFirstChild("Goal") or SkillCheckCheck:WaitForChild("Goal", 5)

local function clickSkillCheck()
    pcall(function()
        local pg = PlayerGui:FindFirstChild("Survivor-mob")
        local action = pg and pg:FindFirstChild("Controls") and pg.Controls:FindFirstChild("action")
        if action and action.Visible then
            if firesignal then
                pcall(function() firesignal(action.MouseButton1Down) end)
                task.wait(0.01)
                pcall(function() firesignal(action.MouseButton1Up) end)
                return
            end
        else
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.01)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end
    end)
end

local function stopSkillCheck()
    if SkillCheckConnection then
        SkillCheckConnection:Disconnect()
        SkillCheckConnection = nil
    end
end

local function refreshSkillCheckReferences()
    if not SkillCheckPromptGui or not SkillCheckPromptGui.Parent then
        return false
    end
    SkillCheckCheck = SkillCheckPromptGui:FindFirstChild("Check")
    if not SkillCheckCheck then return false end
    SkillCheckLine = SkillCheckCheck:FindFirstChild("Line")
    SkillCheckGoal = SkillCheckCheck:FindFirstChild("Goal")
    return SkillCheckLine ~= nil and SkillCheckGoal ~= nil
end

local function startSkillCheck()
    stopSkillCheck()
    if not refreshSkillCheckReferences() then return end
    if not SkillCheckPromptGui.Enabled or not SkillCheckCheck.Visible then return end
    local ok, rot = pcall(function() return SkillCheckGoal.Rotation end)
    if not ok then return end
    SkillCheckGoalRotation = rot
    if SkillCheckMode == "Instant" then
        SkillCheckLine.Rotation = 109 + rot
        clickSkillCheck()
        return
    end
    local targetLow = 109 + rot
    local targetHigh = 116 + rot
    SkillCheckConnection = RunService.Heartbeat:Connect(function()
        if not AutoSkillCheckActive or not refreshSkillCheckReferences() or not SkillCheckCheck.Visible then
            stopSkillCheck()
            return
        end
        local ok2, current = pcall(function() return SkillCheckLine.Rotation end)
        if not ok2 then stopSkillCheck() return end
        if current > targetHigh + 1 then
            stopSkillCheck()
            return
        end
        if current >= targetLow and current <= targetHigh then
            stopSkillCheck()
            pcall(clickSkillCheck)
        end
    end)
end

local function setupSkillCheckDetection()
    stopSkillCheck()
    SkillCheckGoalRotation = -1
    if not SkillCheckPromptGui or not SkillCheckCheck or not SkillCheckLine or not SkillCheckGoal then
        return
    end
    SkillCheckGoal:GetPropertyChangedSignal("Rotation"):Connect(function()
        local check = SkillCheckPromptGui and SkillCheckPromptGui:FindFirstChild("Check")
        local goal = check and check:FindFirstChild("Goal")
        if not goal then return end
        if goal.Rotation ~= 0 and AutoSkillCheckActive and goal.Rotation ~= SkillCheckGoalRotation then
            SkillCheckGoal = goal
            SkillCheckCheck = check
            SkillCheckLine = check:FindFirstChild("Line")
            task.spawn(startSkillCheck)
        end
    end)
    SkillCheckCheck:GetPropertyChangedSignal("Visible"):Connect(function()
        local check = SkillCheckPromptGui and SkillCheckPromptGui:FindFirstChild("Check")
        if not check then return end
        if check.Visible and AutoSkillCheckActive then
            SkillCheckCheck = check
            SkillCheckLine = check:FindFirstChild("Line")
            SkillCheckGoal = check:FindFirstChild("Goal")
            SkillCheckGoalRotation = -1
            task.spawn(startSkillCheck)
        end
    end)
end

local KingScourgeBusy = false
KingScourgeStart.OnClientEvent:Connect(function(_, target, count)
    if not AutoSkillCheckActive or SkillCheckMode ~= "Instant" then return end
    if KingScourgeBusy then return end
    KingScourgeBusy = true
    local c = count or 1
    task.spawn(function()
        for _ = 1, c do
            pcall(function()
                KingScourgeHit:FireServer(target, "success")
            end)
            task.wait(0.06)
        end
        KingScourgeBusy = false
        task.wait(0.1)
        if SkillCheckCheck and SkillCheckCheck.Visible and SkillCheckGoal and SkillCheckGoal.Rotation ~= 0 then
            task.spawn(startSkillCheck)
        end
    end)
end)

