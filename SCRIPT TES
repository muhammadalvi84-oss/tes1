                high.Adornee = v
                high.FillColor = Color3.fromRGB(255, 128, 0)
                high.OutlineColor = Color3.fromRGB(255, 128, 0)
                high.FillTransparency = 1
                high.OutlineTransparency = 0
            end
        end
    end
    if ESP_Window then
        for _, v in ipairs(Windows) do
            if v and v.Parent then
                local part = v:FindFirstChild("Bottom") or v:FindFirstChildWhichIsA("BasePart")
                if part then
                    local ad = v:FindFirstChild("WindowEH")
