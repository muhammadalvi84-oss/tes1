local groupNextKiller = TabEsp:AddRightGroupbox("Next Killer", "skull")
local NextKillerActive = false
local NextKillerGui = nil
local function createNextKillerGui()
    if NextKillerGui then NextKillerGui:Destroy() end
    NextKillerGui = Instance.new("ScreenGui")
    NextKillerGui.Name = "NextKillerIndicator"
    NextKillerGui.ResetOnSpawn = false
    NextKillerGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end
local function startNextKillerDisplay()
    if NextKillerGui then return end
    createNextKillerGui()
    task.spawn(function()
        while NextKillerActive and NextKillerGui do
            local display = NextKillerGui:FindFirstChild("NextKillerDisplay")
            if not display then
                display = Instance.new("TextLabel")
                display.Name = "NextKillerDisplay"
                display.Size = UDim2.new(0, 290, 0, 42)
                display.Position = UDim2.new(0.5, 0, 0, 60)
                display.AnchorPoint = Vector2.new(0.5, 0)
                display.BackgroundTransparency = 0.35
                display.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
                display.TextColor3 = Color3.new(1, 1, 1)
                display.Font = Enum.Font.GothamBold
                display.TextSize = 15.5
                display.RichText = true
                display.Parent = NextKillerGui
                Instance.new("UICorner", display).CornerRadius = UDim.new(0, 12)
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.8
                stroke.Color = Color3.fromRGB(130, 80, 255)
                stroke.Transparency = 0.4
                stroke.Parent = display
            end
            local players = Players:GetPlayers()
            table.sort(players, function(a, b)
                local aAllow = a:GetAttribute("AllowKiller") or false
                local bAllow = b:GetAttribute("AllowKiller") or false
                if aAllow ~= bAllow then return aAllow end
                return (a:GetAttribute("KillerChance") or 0) > (b:GetAttribute("KillerChance") or 0)
            end)
            local top = players[1]
            if top then
                display.Text = "Next Killer: " .. (top == LocalPlayer and "<font color='#ff3333'><b>KAMU</b></font>" or top.Name)
            else
                display.Text = "Next Killer: <font color='#888888'>Waiting for match...</font>"
            end
            task.wait(1.5)
        end
    end)
end
local function stopNextKillerDisplay()
    if NextKillerGui then
        NextKillerGui:Destroy()
        NextKillerGui = nil
    end
end
