local function updateGeneratorEsp()
    if not ESP_Master then return end
    if ESP_Generator then
        for _, v in ipairs(Generators) do
            local model = v.model
            if model and model.Parent then
                local progress = math.floor(model:GetAttribute("RepairProgress") or 0)
                local done = progress >= 100
                local color = done and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 0)
                local highlight = model:FindFirstChild("GEH")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "GEH"
                    highlight.Parent = model
                end
                highlight.FillColor = color
                highlight.OutlineColor = color
                highlight.FillTransparency = 1
                highlight.OutlineTransparency = 0
                local sub = done and "DONE 100%" or string.format("%d%%", progress)
                createEspBillboard(model, "GE_Text", {
                    name = "GEN",
                    subtext = sub,
                    color = color,
                    icon = nil
                })
            end
        end
    end
    if ESP_Pallet then
        for _, v in ipairs(Pallets) do
            if v and v.Parent then
                local high = v:FindFirstChild("PalletEH")
                if not high then
                    high = Instance.new("Highlight")
                    high.Name = "PalletEH"
                    high.Parent = v
