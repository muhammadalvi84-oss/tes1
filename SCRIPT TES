local function isWeaponOrArm(part)
    if part:IsA("Tool") then return true end
    if part.Parent and (part.Parent.Name == "Left Arm" or part.Parent.Name == "Right Arm" or part.Parent.Name == "LeftHand" or part.Parent.Name == "RightHand" or part.Parent.Name == "LeftLowerArm" or part.Parent.Name == "RightLowerArm" or part.Parent.Name == "LeftUpperArm" or part.Parent.Name == "RightUpperArm") then
        return true
    end
    local name = part.Name:lower()
    if name:match("weapon") or name:match("gun") or name:match("blade") then
        return true
    end
    return false
end

local function fakeNameSpoofer()
    if not Misc_FakeName then return end
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then return end
    local function processDescendant(desc)
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            local function updateText()
                if not Misc_FakeName then return end
                local text = desc.Text
                local changed = false
                if not desc:GetAttribute("OriginalText") then
                    desc:SetAttribute("OriginalText", text)
                end
                for _, player in ipairs(Players:GetPlayers()) do
                    if string.find(text, player.Name) or string.find(text, player.DisplayName) then
                        text = string.gsub(text, player.Name, "PANDU HUB")
                        text = string.gsub(text, player.DisplayName, "PANDU HUB")
                        changed = true
                    end
                end
                if changed and text ~= desc.Text then
                    desc.Text = text
                end
            end
            updateText()
            local conn = desc:GetPropertyChangedSignal("Text"):Connect(updateText)
            table.insert(SpooferConns, conn)
            return
        end
        if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            local function updateImage()
                if not Misc_FakeName then return end
                local image = desc.Image
                local changed = false
                for _, player in ipairs(Players:GetPlayers()) do
                    if string.find(image, tostring(player.UserId)) then
                        if not desc:GetAttribute("OriginalImage") then
                            desc:SetAttribute("OriginalImage", image)
                        end
                        changed = true
                        break
                    end
                end
                if changed and desc.Image ~= "rbxassetid://109651670989001" then
                    desc.Image = "rbxassetid://109651670989001"
                end
            end
            updateImage()
            local conn = desc:GetPropertyChangedSignal("Image"):Connect(updateImage)
            table.insert(SpooferConns, conn)
        end
    end
    for _, descendant in ipairs(PlayerGui:GetDescendants()) do
        processDescendant(descendant)
    end
    local conn = PlayerGui.DescendantAdded:Connect(function(desc)
        task.defer(function()
            processDescendant(desc)
        end)
    end)
    table.insert(SpooferConns, conn)
end

local function stopFakeNameSpoofer()
    for _, conn in ipairs(SpooferConns) do
        if conn.Connected then conn:Disconnect() end
    end
    table.clear(SpooferConns)
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if PlayerGui then
        for _, desc in ipairs(PlayerGui:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                local orig = desc:GetAttribute("OriginalText")
                if orig then
                    desc.Text = orig
                    desc:SetAttribute("OriginalText", nil)
                end
            elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                local orig = desc:GetAttribute("OriginalImage")
                if orig then
                    desc.Image = orig
                    desc:SetAttribute("OriginalImage", nil)
                end
            end
        end
    end
end

local function isParrySafe(character)
    if not Surv_ParrySafety then return true end
    if not character then return false end
    local check = character:FindFirstChild("CheckInterractable")
    if check then
        if check:GetAttribute("isVaulting") == true then return false end
        if check:GetAttribute("isRepairing") == true then return false end
        if check:GetAttribute("isUnhooking") == true then return false end
        if check:GetAttribute("isHealing") == true then return false end
        if check:GetAttribute("isSliding") == true then return false end
    end
    return true
end

