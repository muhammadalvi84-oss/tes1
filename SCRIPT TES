local function getNearestKillerForFlash()
    local nearest, dist = nil, 1e999
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isKiller(player) and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp and not isKnockedOrHooked(player.Character) then
                local mag = (hrp.Position - root.Position).Magnitude
                if mag < dist then
                    dist = mag
                    nearest = hrp
                end
            end
        end
    end
    return nearest
end

