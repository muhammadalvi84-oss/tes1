local function updateEsp()
    if not ESP_Master then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if ESP_KillerWarn and root and getPlayerTeamName() == "Survivor" then
        local warn = root:FindFirstChild("KillerWarn")
        local nearestDist = 1e999
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and isKiller(player) and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local mag = (hrp.Position - root.Position).Magnitude
                    if mag < nearestDist then
                        nearestDist = mag
                    end
                end
            end
        end
        if nearestDist <= 80 then
            if not warn then
                warn = Instance.new("BillboardGui")
                warn.Name = "KillerWarn"
                warn.Size = UDim2.new(0, 30, 0, 30)
                warn.AlwaysOnTop = true
                warn.StudsOffset = Vector3.new(0, 4, 0)
                warn.Parent = root
                local label = Instance.new("TextLabel")
                label.Name = "WarnText"
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextScaled = true
                label.TextStrokeTransparency = 0
                label.Font = Enum.Font.GothamBlack
                label.Parent = warn
            end
            local txt = warn:FindFirstChild("WarnText")
            if txt then
                if nearestDist <= 40 then
                    txt.Text = "!!"
                    txt.TextColor3 = Color3.fromRGB(255, 0, 0)
                else
                    txt.Text = "!"
                    txt.TextColor3 = Color3.fromRGB(255, 255, 0)
                end
            end
        elseif warn then
            warn:Destroy()
        end
    else
        if root and root:FindFirstChild("KillerWarn") then
            root.KillerWarn:Destroy()
        end
    end
    if ESP_Player or ESP_Killer then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local isK = isKiller(player)
                local head = player.Character:FindFirstChild("Head")
                if head and ((not isK and ESP_Player) or (isK and ESP_Killer)) then
                    local dist = root and math.floor((head.Position - root.Position).Magnitude) or 0
                    local color = isK and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(57, 255, 20)
                    local highName = isK and "KEH" or "PEH"
                    local textName = isK and "KE_Text" or "PE_Text"
                    local highlight = player.Character:FindFirstChild(highName)
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = highName
                        highlight.Parent = player.Character
                    end
                    highlight.FillColor = color
                    highlight.OutlineColor = color
                    highlight.FillTransparency = 1
                    highlight.OutlineTransparency = 0
                    if ESP_Name then
                        local icon
                        if ESP_ItemIcon and not isK then
                            local equipped = player:GetAttribute("EquippedItem")
                            if equipped and equipped ~= "" then
                                icon = getItemIcon(equipped)
                            end
                        end
                        createEspBillboard(player.Character, textName, {
                            name = player.Name,
                            distance = ESP_Distance and dist or nil,
                            color = color,
                            icon = icon
                        })
                    else
                        local existing = player.Character:FindFirstChild(textName)
                        if existing then existing:Destroy() end
                    end
                end
            end
        end
    end
end

local function clearEsp(category)
    if category == "Player" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                if player.Character:FindFirstChild("PEH") then player.Character.PEH:Destroy() end
                if player.Character:FindFirstChild("PE_Text") then player.Character.PE_Text:Destroy() end
            end
        end
        return
    end
    if category == "Killer" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                if player.Character:FindFirstChild("KEH") then player.Character.KEH:Destroy() end
                if player.Character:FindFirstChild("KE_Text") then player.Character.KE_Text:Destroy() end
            end
        end
        return
    end
    if category == "Generator" then
        for _, v in ipairs(Generators) do
            if v.model and v.model.Parent then
                if v.model:FindFirstChild("GEH") then v.model.GEH:Destroy() end
                if v.model:FindFirstChild("GE_Text") then v.model.GE_Text:Destroy() end
            end
        end
        return
    end
    if category == "Pallet" then
        for _, v in ipairs(Pallets) do
            if v and v.Parent and v:FindFirstChild("PalletEH") then
                v.PalletEH:Destroy()
            end
        end
        return
    end
    if category == "Hook" then
        for _, v in ipairs(Hooks) do
            if v and v.Parent and v:FindFirstChild("HookEH") then
                v.HookEH:Destroy()
            end
        end
        return
    end
    if category == "Window" then
        for _, v in ipairs(Windows) do
            if v and v.Parent and v:FindFirstChild("WindowEH") then
                v.WindowEH:Destroy()
            end
        end
        return
    end
    if category == "Gate" then
        for _, v in ipairs(Gates) do
            if v and v.Parent and v:FindFirstChild("GateEH") then
                v.GateEH:Destroy()
            end
        end
        return
    end
    if category == "SCP" then
        for _, v in ipairs(SCPs) do
            if v and v.Parent and v:FindFirstChild("SCPEH") then
                v.SCPEH:Destroy()
            end
        end
    end
end

