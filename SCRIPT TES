local function lerpCameraToPart(part, speed)
    if not part then return end
    speed = speed or 0.1
    local cf = CFrame.lookAt(CurrentCamera.CFrame.Position, part.Position)
    CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(cf, speed)
end

local function getNearestPlayer()
    local nearest, dist = nil, 50
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local team = player.Team and player.Team.Name:lower()
            local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name:lower()
            if team ~= myTeam then
                local mag = (hrp.Position - root.Position).Magnitude
                if mag < dist then
                    dist = mag
                    nearest = player
                end
            end
        end
    end
    return nearest, dist
end

local function refreshMapCache()
    table.clear(Generators)
    table.clear(Windows)
    table.clear(Pallets)
    table.clear(Hooks)
    table.clear(Gates)
    table.clear(SCPs)
    local map = workspace:FindFirstChild("Map") or workspace
    local descendants = map:GetDescendants()
    for i, v in ipairs(descendants) do
        if i % 200 == 0 then task.wait() end
        if v:IsA("Model") then
            local name = string.lower(v.Name)
            if name == "generator" then
                local part = v:FindFirstChildWhichIsA("BasePart")
                if part then
                    table.insert(Generators, { model = v, part = part })
                end
            elseif name == "hook" and v:FindFirstChild("HookPoint") then
                table.insert(Hooks, v)
            elseif name == "gate" and v:FindFirstChild("ExitLever") then
                table.insert(Gates, v)
            elseif name == "window" then
                table.insert(Windows, v)
            end
        elseif v:IsA("BasePart") and v.Name == "PrimaryPartPallet" then
            local parent = v.Parent
            if parent and not table.find(Pallets, parent) then
                table.insert(Pallets, parent)
            end
        end
    end
    local allDesc = workspace:GetDescendants()
    for i, v in ipairs(allDesc) do
        if i % 200 == 0 then task.wait() end
        if v:IsA("Model") and string.match(string.lower(v.Name), "^scp") and not table.find(SCPs, v) then
            table.insert(SCPs, v)
        end
    end
end

local Items = ReplicatedStorage:WaitForChild("Items", 5)

local function extractIdFromString(str)
    return tostring(str):match("%d+")
end

local function getItemIcon(itemName)
    if not Items then return nil end
    local item = Items:FindFirstChild(itemName)
    if not item then return nil end
    local icon
    pcall(function()
        icon = item.Texture or item.Image
    end)
    if icon and icon ~= "" then
        local id = extractIdFromString(icon)
        if id then
            return string.format("rbxthumb://type=Asset&id=%s&w=420&h=420", id)
        end
    end
    return nil
end

