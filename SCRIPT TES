    if not AUTO_AFKEscape then return end
    if AFK_Thread then task.cancel(AFK_Thread) end
    if team == "Survivors" then
        AFK_Thread = task.spawn(function()
            if Library then Library:Notify("AFK Mode ON!", 3) end
            task.wait(18)
            if AUTO_AFKEscape and LocalPlayer.Team and LocalPlayer.Team.Name == "Survivors" then
